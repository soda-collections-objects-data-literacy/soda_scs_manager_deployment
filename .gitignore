# Note: submodules (scs-health, webprotege, jupyterhub, …) have their own
# .gitignore; patterns here do not apply inside them.

# IDE / editor / OS
.vscode/
.idea/
.cursor/
*.swp
*~
.DS_Store

# Secrets and local environment
*.env
.env.*
!*.env.sample
!*.env.example
acme.json
*.pem
*.key

# Data, backups, archives, logs
volumes/
/backups/
/exports/
*.tar.gz
*.log

# Generated / caches
/.cache/
/.docs-build/
/site/

# Local checkouts and tools (not part of this repo)
/repos/
/[Oo]penrefine/

# AI
/plans/
