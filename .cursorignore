# Blocks Cursor AI access and indexing. Gitignored files are already
# excluded from indexing; this file is for things the agent must never read.

# Secrets
.env
*.env
.env.*
!*.env.sample
!*.env.example
acme.json
*.pem
*.key

# Data, backups, archives (large and may contain personal data)
volumes/*
scs-manager-stack/volumes/*
!scs-manager-stack/volumes/drupal-root/
scs-manager-stack/volumes/drupal-root/*
!scs-manager-stack/volumes/drupal-root/web/
scs-manager-stack/volumes/drupal-root/web/*
!scs-manager-stack/volumes/drupal-root/web/modules/
scs-manager-stack/volumes/drupal-root/web/modules/*
!scs-manager-stack/volumes/drupal-root/web/modules/custom/
backups/
exports/
*.tar.gz
*.sql
*.sql.gz
*.log

# Dependencies and build output
node_modules/
.next/
vendor/
/.cache/
/.docs-build/
/site/
