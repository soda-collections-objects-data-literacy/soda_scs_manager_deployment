# Traefik.
# Optional: dashboard hostname. If unset, defaults to reverse-proxy.${SCS_SUBDOMAIN}.${SCS_BASE_DOMAIN}
# (e.g. reverse-proxy.scs.sammlungen.io when those match your DNS). Set explicitly only for a custom name.
SCS_TRAEFIK_DOMAIN=reverse-proxy.scs.sammlungen.io
SCS_TRAEFIK_EMAIL=admin@example.com
SCS_TRAEFIK_PASSWORD=
SCS_TRAEFIK_HASHED_PASSWORD=
SCS_TRAEFIK_USERNAME=admin
SCS_TRAEFIK_SERVICE_NAME=reverse-proxy
# Reference ClientIP() CIDRs for internal bypass routers (hardcoded in compose overrides; adjust if reverse-proxy subnet differs):
# ClientIP(`172.16.0.0/12`) || ClientIP(`192.168.0.0/16`) || ClientIP(`10.0.0.0/8`) || ClientIP(`127.0.0.1/32`) || ClientIP(`::1/128`) || ClientIP(`fd00::/8`)

# SCS Health.
SCS_HEALTH_DOMAIN=health.scs.sammlungen.io
# Session signing secret for scs-health login (generate: openssl rand -base64 32)
SCS_HEALTH_AUTH_SECRET=
# Local login credentials (defaults to SCS_TRAEFIK_USERNAME / SCS_TRAEFIK_PASSWORD)
SCS_HEALTH_AUTH_USER=
SCS_HEALTH_AUTH_PASSWORD=
# Optional Keycloak OIDC (client must exist in realm; redirect: https://${SCS_HEALTH_DOMAIN}/api/auth/callback/keycloak)
SCS_HEALTH_OIDC_CLIENT_ID=
SCS_HEALTH_OIDC_CLIENT_SECRET=
SCS_HEALTH_OIDC_ISSUER=

# WebProtégé.
WEBPROTEGE_WEBPROTEGE_DOMAIN=webprotege.scs.localhost
# WebProtégé email configuration (optional; if not set, configure via mail.properties file).
# SMTP server hostname (e.g., smtp.gmail.com, smtp.mailgun.org).
WEBPROTEGE_MAIL_SMTP_HOST=
# SMTP server port (common: 587 for STARTTLS, 465 for SSL/TLS).
WEBPROTEGE_MAIL_SMTP_PORT=587
# Enable SMTP authentication (true/false).
WEBPROTEGE_MAIL_SMTP_AUTH=false
# SMTP username (required if auth is true).
WEBPROTEGE_MAIL_SMTP_USER=
# SMTP password (required if auth is true).
WEBPROTEGE_MAIL_SMTP_PASSWORD=
