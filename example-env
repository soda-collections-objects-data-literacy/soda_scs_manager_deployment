SCS_MANAGER_DRUPAL_PROXY_ADDRESSES='172.18.0.0/16|172.19.0.0/16|172.20.0.0/16'
# 'localhost|manager.scs.sammlungen.io|raw.manager.scs.sammlungen.io'
SCS_MANAGER_DRUPAL_TRUSTED_HOSTS='localhost|manager.scs.sammlungen.io|raw.manager.scs.sammlungen.io'
SCS_MANAGER_SECOND_DOMAIN=scs.localhost


# phpMyAdmin / DBMS (with Keycloak SSO)
SCS_DBMS_DOMAIN=dbms.scs.localhost
SCS_DBMS_DEFAULT_SERVER=${SCS_CONTAINER_DATABASE}
# Keycloak client for phpMyAdmin SSO (create client with redirect URI https://${SCS_DBMS_DOMAIN}/_oauth)
SCS_DBMS_CLIENT_SECRET=
# Forward-auth: 32-char hex string for cookie encryption; random string for secret
SCS_DBMS_FORWARD_AUTH_ENCRYPTION_KEY=
SCS_DBMS_FORWARD_AUTH_SECRET=
# phpMyAdmin configuration storage (pmadb): password for control user 'pma'. Enables bookmarks, history, recent tables.
