NEXTCLOUD_NEXTCLOUD_SERVICE_NAME=nextcloud
# Required for OnlyOffice. If empty, DOCX etc. won't open (Invalid token). Run fix-onlyoffice-jwt.bash to generate.
NEXTCLOUD_ONLYOFFICE_JWT_SECRET=
NEXTCLOUD_ONLYOFFICE_PORT=8081
NEXTCLOUD_ONLYOFFICE_SERVICE_NAME=office
NEXTCLOUD_ONLYOFFICE_DOCUMENT_SERVER_DOMAIN=nextcloud-onlyoffice-document-server
NEXTCLOUD_ONLYOFFICE_DOMAIN=office.scs.localhost
NEXTCLOUD_REDIS_HOST_PORT=6379
NEXTCLOUD_REDIS_HOST=nextcloud--redis
NEXTCLOUD_CLIENT_SECRET=
NEXTCLOUD_CLIENT_ID=http://drive.scs.localhost
# ISO 3166-1 region for phone validation without country code (e.g. DE). Optional; set to fix admin warning.
NEXTCLOUD_NEXTCLOUD_DEFAULT_PHONE_REGION=DE

# Nextcloud Social Login Configuration.
# Basic settings (0 = disabled, 1 = enabled).
NEXTCLOUD_SOCIALLOGIN_ALLOW_LOGIN_CONNECT=0
NEXTCLOUD_SOCIALLOGIN_AUTO_CREATE_GROUPS=0
NEXTCLOUD_SOCIALLOGIN_BUTTON_TEXT_WO_PREFIX=0
NEXTCLOUD_SOCIALLOGIN_CREATE_DISABLED_USERS=0
NEXTCLOUD_SOCIALLOGIN_DISABLE_NOTIFY_ADMINS=0
NEXTCLOUD_SOCIALLOGIN_DISABLE_REGISTRATION=0
NEXTCLOUD_SOCIALLOGIN_HIDE_DEFAULT_LOGIN=1
NEXTCLOUD_SOCIALLOGIN_NO_PRUNE_USER_GROUPS=0
NEXTCLOUD_SOCIALLOGIN_PREVENT_CREATE_EMAIL_EXISTS=1
NEXTCLOUD_SOCIALLOGIN_RESTRICT_USERS_WO_ASSIGNED_GROUPS=0
NEXTCLOUD_SOCIALLOGIN_RESTRICT_USERS_WO_MAPPED_GROUPS=0
NEXTCLOUD_SOCIALLOGIN_UPDATE_PROFILE_ON_LOGIN=1

# Nextcloud Social Login Keycloak Provider Configuration.
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_REALM=wisski
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_CLIENT_ID=http://drive.scs.localhost
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_CLIENT_SECRET=
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_SCOPE=openid email groups profile
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_DISPLAY_NAME_CLAIM=username
NEXTCLOUD_SOCIALLOGIN_KEYCLOAK_GROUPS_CLAIM=groups

# Nextcloud email configuration (optional; if not set, configure via admin UI).
# Mode: smtp (recommended), sendmail, or php.
NEXTCLOUD_NEXTCLOUD_MAIL_MODE=smtp
# SMTP server and port (common: smtp.gmail.com:587, smtp.mailgun.org:587, smtp.office365.com:587).
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_HOST=
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_PORT=587
# Encryption: ssl (for port 465) or tls (for port 587).
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_SECURE=tls
# SMTP authentication: 1 for enabled, empty or 0 for disabled.
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_AUTH=1
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_USERNAME=
NEXTCLOUD_NEXTCLOUD_MAIL_SMTP_PASSWORD=
# From address: email address Nextcloud uses as sender.
NEXTCLOUD_NEXTCLOUD_MAIL_FROM_ADDRESS=noreply
# Domain part of from address (e.g., yourdomain.com results in noreply@yourdomain.com).
NEXTCLOUD_NEXTCLOUD_MAIL_DOMAIN=

# --- Nextcloud mounter sidecar (rclone rcd / FUSE mounts) ---
# Host directory must be a self-bound rshared mount before starting Docker
# consumers (see 01_scripts/global/setup-nextcloud-mounts.sh).
NEXTCLOUD_MOUNTS_ROOT=/var/lib/scs/nextcloud-mounts
NEXTCLOUD_MOUNTER_RC_USER=scs-manager
# Generate with: openssl rand -hex 32
NEXTCLOUD_MOUNTER_RC_PASS=
# Optional override; default http://${SCS_CONTAINER_NEXTCLOUD_MOUNTER}:5572
NEXTCLOUD_MOUNTER_RC_URL=http://${SCS_CONTAINER_NEXTCLOUD_MOUNTER}:5572

# Portainer
SCS_PORTAINER_DOMAIN=deployments.scs.localhost
SCS_PORTAINER_EDGE_DOMAIN=edge.scs.localhost
SCS_PORTAINER_EDGE_SERVICE_NAME=edge
