# Compose files for single-command startup.
# Docker Compose loads this file as `.env` only from the project directory (repo root).
# Run `docker compose` from the same directory as `docker-compose.yml`, or use:
#   docker compose --project-directory /path/to/soda_scs_manager_deployment …
# Otherwise variables here are missing during parsing and you see "variable is not set" warnings.
# Place overrides at the end of the list. See docs/service-infrastructure/index.md for more details.
COMPOSE_FILE=docker-compose.yml:jupyterhub/docker-compose.yml:00_custom_configs/jupyterhub/docker/docker-compose.override.yml:keycloak/docker-compose.yml:00_custom_configs/keycloak/docker/docker-compose.override.yml:open_gdb/docker-compose.yml:00_custom_configs/open_gdb/docker/docker-compose.override.yml:scs-manager-stack/docker-compose.yml:scs-manager-stack/docker-compose.override.yml:scs-nextcloud-stack/docker-compose.yml:00_custom_configs/scs-nextcloud-stack/docker/docker-compose.override.yml:scs-project-website-stack/docker-compose.yml:scs-project-website-stack/docker-compose.override.yml:webprotege/docker-compose.yml:00_custom_configs/webprotege/docker/docker-compose.override.yml:scs-health/docker-compose.yml:00_custom_configs/scs-health/docker/docker-compose.override.yml:00_custom_configs/phpmyadmin/docker/docker-compose.override.yml

# General
MODE=production
SCS_BASE_DOMAIN=localhost
SCS_SUBDOMAIN=scs
SCS_ROOT_PATH=/var/deploy/soda_scs_manager_deployment
SCS_SHARED_DATA=shared_data

# Database.
SCS_DB_PORT=3306
SCS_DB_ROOT_PASSWORD=
SCS_DB_SERVICE_NAME=db
SCS_DB_DOMAIN=dbms.scs.localhost

# --- Docker DNS / container_name (naming migration) ---
# Compose service key should match these values (see naming-vocabulary.md).
# Flipped names keep a Docker network alias for the old DNS until soak
# (e.g. core--mariadb--db aliases scs--database;
# core--traefik--edge aliases scs--reverse-proxy). Do not drop aliases
# until soda_scs_manager.settings and leftover *_DB_HOST values are cut over.
# Shared helper for scripts: 01_scripts/global/scs-container-names.bash
SCS_CONTAINER_DATABASE=core--mariadb--db
SCS_CONTAINER_REVERSE_PROXY=core--traefik--edge
SCS_CONTAINER_NEXTCLOUD_MOUNTER=nextcloud-mounter
SCS_CONTAINER_AUTHPROXY=opengdb--authproxy--proxy
SCS_CONTAINER_RDF4J=opengdb--rdf4j--db
SCS_CONTAINER_OUTPROXY=opengdb--outproxy--proxy
SCS_CONTAINER_OPENGDB_PROXY=opengdb--nginx--edge
SCS_CONTAINER_PORTAINER=core--portainer--app
SCS_CONTAINER_PHPMYADMIN=dbms--phpmyadmin--app
SCS_CONTAINER_FORWARD_AUTH=dbms--forwardauth--proxy
SCS_CONTAINER_ECHO=core--echo--app
SCS_CONTAINER_HEALTH=health--health--app
SCS_CONTAINER_KEYCLOAK=keycloak--keycloak--app
SCS_CONTAINER_MANAGER=manager--drupal--app
SCS_CONTAINER_MANAGER_REDIS=manager--redis--cache
SCS_CONTAINER_NEXTCLOUD=nextcloud--nextcloud--app
SCS_CONTAINER_NEXTCLOUD_REDIS=nextcloud--redis--cache
SCS_CONTAINER_NEXTCLOUD_EDGE=nextcloud--nginx--edge
SCS_CONTAINER_ODS=nextcloud--ods--app
SCS_CONTAINER_ODS_EDGE=nextcloud--ods--edge
SCS_CONTAINER_JUPYTERHUB=jupyterhub--jupyterhub--app
SCS_CONTAINER_JUPYTERHUB_BUILDER=jupyterhub--spawner--builder
SCS_CONTAINER_WEBPROTEGE=webprotege--webprotege--app
SCS_CONTAINER_WEBPROTEGE_MONGODB=webprotege--mongodb--db
# INTERNAL_TS_BASE stays on the alias until WissKI TS_* / Manager internalHost cutover.
INTERNAL_TS_BASE=http://scs--authproxy:8000
# Derived (override if needed):
# NEXTCLOUD_MOUNTER_RC_URL=http://${SCS_CONTAINER_NEXTCLOUD_MOUNTER}:5572

# Open GDB.
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECRET_KEY=
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NAME=admin
DJANGO_SUPERUSER_PASSWORD=
OPEN_GDB_DOMAIN=ts.scs.localhost
PUBLIC_PORT=8082

# Jupyter.
# Optional if it matches code.${SCS_SUBDOMAIN}.${SCS_BASE_DOMAIN}; compose defaults match that pattern.
JUPYTERHUB_DOMAIN=code.scs.localhost
JUPYTERHUB_OPENREFINE_DIR=${SCS_ROOT_PATH}/openrefine
# Docker DNS / hub_connect_ip — must match container_name (not the public Host).
JUPYTERHUB_SERVICE_NAME=jupyterhub--jupyterhub--app
JUPYTERHUB_SHARE=shared-data
JUPYTERHUB_CLIENT_SECRET=
JUPYTERHUB_CLIENT_ID=http://code.scs.localhost
JUPYTERHUB_NETWORK=reverse-proxy

# Keycloak.
KC_ADMIN_GROUPS=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_DB_DRIVER=mariadb
KC_DB_HOST=${SCS_CONTAINER_DATABASE}
KC_DB_NAME=keycloak
KC_DB_PASSWORD=
KC_DB_PORT=3306
KC_DB_USERNAME=keycloak
KC_DOMAIN=auth.scs.localhost
KC_HOSTNAME=auth.scs.localhost
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_REALM=main
KC_SERVICE_NAME=auth
KC_URL=https://auth.scs.localhost
KC_USER_GROUPS=user
KC_VERSION=26.0.0
KC_DIDMOS_CLIENT_SECRET=
KC_DIDMOS_CLIENT_ID=didmos

# Nextcloud.
NEXTCLOUD_ADMIN_PASSWORD=nextcloudpass
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_DB_HOST=${SCS_CONTAINER_DATABASE}
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_PASSWORD=nextcloudpass
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_NEXTCLOUD_DOMAIN=drive.scs.localhost
NEXTCLOUD_NEXTCLOUD_PORT=8080
