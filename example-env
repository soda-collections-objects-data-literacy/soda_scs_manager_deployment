SCS_DOCS_OAUTH2_COOKIE_SECRET=
SCS_MANAGER_DB_DRIVER=mysql
SCS_MANAGER_DB_HOST=${SCS_CONTAINER_DATABASE}
SCS_MANAGER_DB_IMAGE_VERSION=11.5
SCS_MANAGER_DB_NAME=scs_manager
SCS_MANAGER_DB_PASSWORD=scsmanagerpass
SCS_MANAGER_DB_PORT=3306
SCS_MANAGER_DB_ROOT_PASSWORD=scsmanagerrootpass
SCS_MANAGER_DB_USER=scsmanager
SCS_MANAGER_DRUPAL_PORT=8080
SCS_MANAGER_IMAGE_VERSION=latest
SCS_MANAGER_MODE=development
SCS_MANAGER_DRUPAL_PASSWORD=drupalpass
SCS_MANAGER_REDIS_IMAGE_VERSION=8-alpine
SCS_MANAGER_SERVICE_NAME=manager
SCS_MANAGER_SITE_NAME="SCS Manager"
SCS_MANAGER_DRUPAL_USER=drupaluser
SCS_MANAGER_VARNISH_IMAGE_VERSION=1.0.0
