[Unit]
Description=Reconcile SCS Nextcloud FUSE mounts (user Drives and project Team Folders)
# Drupal cron (automated_cron) runs only every few hours; this keeps mounts
# current after sidecar restarts, renames and JupyterHub changes.
After=docker.service scs-nextcloud-mounts.service
Requires=docker.service

[Service]
Type=oneshot
# "-": a failed user reconcile must not skip the project reconcile.
ExecStart=-/usr/bin/docker exec manager--drupal--app drush scs:nextcloud-reconcile
ExecStart=-/usr/bin/docker exec manager--drupal--app drush scs:nextcloud-project-reconcile
# Tell the SCS system check (drush scs:check, status report) that the timer runs.
ExecStartPost=/usr/bin/docker exec -u www-data manager--drupal--app /usr/local/bin/drush --root=/opt/drupal scs:heartbeat nextcloud-mount-reconcile
