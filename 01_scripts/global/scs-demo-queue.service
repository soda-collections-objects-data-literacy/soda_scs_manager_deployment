[Unit]
Description=Run SCS demo project jobs (template builds, demo provisioning and resets)
# Jobs take minutes, so they run outside Drupal cron. The lease outlasts the
# longest job, otherwise the next run would claim the item a second time.
# It runs as www-data like the runner the web UI starts, so template files and
# logs stay writable for the web server.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec -u www-data manager--drupal--app /usr/local/bin/drush --root=/opt/drupal queue:run soda_scs_manager_demo --time-limit=900 --lease-time=7200
# Tell the SCS system check (drush scs:check, status report) that the timer runs.
ExecStartPost=/usr/bin/docker exec -u www-data manager--drupal--app /usr/local/bin/drush --root=/opt/drupal scs:heartbeat demo-queue
